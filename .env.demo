# TestOps-style API
TESTOPS_ENDPOINT=https://testops.example.test
TESTOPS_USER_API_KEY=replace-with-user-api-key

# eShop storefront
ESHOP_BASE_URL=https://eshop-sample.app
ESHOP_BUYER_LOGIN=buyer@example.test
ESHOP_BUYER_PASSWORD=replace-with-password

# Optional back-office user for future sample cases
ESHOP_ADMIN_BASE_URL=https://admin.eshop-sample.app
ESHOP_ADMIN_LOGIN=admin@example.test
ESHOP_ADMIN_PASSWORD=replace-with-password

# Playwright runtime
PLAYWRIGHT_STORAGE_STATE_DIR=.auth
